            correct: 0,
            hint: "两个动作属于更进一步的良好行为，用‘不仅……而且……’（递进关系）。"
          }
        ]
      },
      {
        level: 3,
        title: "第三关：双溪布洛红树林秘境",
        theme: "欢乐伙伴4B · 关爱生态与环境",
        desc: "挑战最后的【茂】与【护】核心石碑，成为语林方块大师！",
        skyColor: 0x1dd1a1,
        fogColor: 0x10ac84,
        groundType: "grass",
        quizzes: [
          {
            char: "茂",
            pinyin: "mào (部首: 艹)",
            pos: [5, 1, -4],
            prompt: "【词语理解】“双溪布洛湿地保护区里的树木长得十分____密。”",
            options: ["A. 拔", "B. 茂", "C. 拨"],
            correct: 1,
            hint: "植物繁茂生长带有草字头（艹），读作‘茂密’。"
          },
          {
            char: "护",
            pinyin: "hù (部首: 扌)",
            pos: [-6, 1, -6],
            prompt: "【动宾搭配】选出搭配<strong>完全正确</strong>的一组：",
            options: ["A. 保护 — 环境", "B. 保持 — 视力", "C. 遵守 — 垃圾"],
            correct: 0,
            hint: "我们说‘保护环境’、‘保持清洁’、‘遵守规则’。"
          }
        ]
      }
    ];

    let currentLevelIndex = 0;
    let solvedCountInLevel = 0;
    let inQuiz = false;

    // =========================================================================
    // 3. PIXEL PROCEDURAL TEXTURES (Minecraft Look)
    // =========================================================================
    function makeTileTexture(primary, secondary) {
      const cvs = document.createElement('canvas');
      cvs.width = 16;
      cvs.height = 16;
      const ctx = cvs.getContext('2d');
      ctx.fillStyle = primary;
      ctx.fillRect(0, 0, 16, 16);
      ctx.fillStyle = secondary;
      for (let x = 0; x < 16; x += 2) {
        for (let y = 0; y < 16; y += 2) {
          if (Math.random() > 0.45) {
            ctx.fillRect(x, y, 2, 2);
          }
        }
      }
      const tex = new THREE.CanvasTexture(cvs);
      tex.magFilter = THREE.NearestFilter;
      tex.minFilter = THREE.NearestFilter;
      return tex;
    }

    function makeHanziPillarTexture(char, active = false) {
      const cvs = document.createElement('canvas');
      cvs.width = 64;
      cvs.height = 64;
      const ctx = cvs.getContext('2d');
      ctx.fillStyle = active ? "#27ae60" : "#2c3e50";
      ctx.fillRect(0, 0, 64, 64);
      ctx.strokeStyle = active ? "#2ecc71" : "#f39c12";
      ctx.lineWidth = 4;
      ctx.strokeRect(2, 2, 60, 60);

      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 40px 'PingFang SC', 'Microsoft YaHei', sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(char, 32, 34);

      const tex = new THREE.CanvasTexture(cvs);
      tex.magFilter = THREE.NearestFilter;
      return tex;
    }

    const textures = {
      grassTop: makeTileTexture('#5b8c32', '#487127'),
      grassSide: makeTileTexture('#614427', '#4b7528'),
      dirt: makeTileTexture('#614427', '#4e341b'),
      stone: makeTileTexture('#7f8c8d', '#576574'),
      wood: makeTileTexture('#a37c4d', '#7d592f'),
      leaves: makeTileTexture('#27ae60', '#1b7740'),
      sand: makeTileTexture('#eccc68', '#d6a838'),
      portal: makeTileTexture('#8e44ad', '#5c2375')
    };

    const blockMaterials = {
      1: new THREE.MeshLambertMaterial({ map: textures.dirt }),
      2: new THREE.MeshLambertMaterial({ map: textures.stone }),
      3: new THREE.MeshLambertMaterial({ map: textures.wood }),
      4: new THREE.MeshLambertMaterial({ map: textures.leaves, transparent: true, opacity: 0.94 })
    };

    const grassMatArray = [
      new THREE.MeshLambertMaterial({ map: textures.grassSide }),
      new THREE.MeshLambertMaterial({ map: textures.grassSide }),
      new THREE.MeshLambertMaterial({ map: textures.grassTop }),
      new THREE.MeshLambertMaterial({ map: textures.dirt }),
      new THREE.MeshLambertMaterial({ map: textures.grassSide }),
      new THREE.MeshLambertMaterial({ map: textures.grassSide })
    ];

    // =========================================================================
    // 4. THREE.JS INITIALIZATION & SCENE SETUP
    // =========================================================================
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 80);

    const renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap;
    container.appendChild(renderer.domElement);

    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 0.7);
    hemiLight.position.set(0, 40, 0);
    scene.add(hemiLight);

    const dirLight = new THREE.DirectionalLight(0xfff7e6, 0.65);
    dirLight.position.set(16, 32, 16);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 1024;
    dirLight.shadow.mapSize.height = 1024;
    scene.add(dirLight);

    // =========================================================================
    // 5. VOXEL MAP STORAGE & WORLD BUILDER
    // =========================================================================
    const voxelMap = new Map(); // "x,y,z" -> Mesh
    let quizPillars = [];
    let portalMesh = null;
    const boxGeo = new THREE.BoxGeometry(1, 1, 1);

    function getKey(x, y, z) {
      return `${Math.floor(x)},${Math.floor(y)},${Math.floor(z)}`;
    }

    function addBlock(x, y, z, mat, isIndestructible = false) {
      const k = getKey(x, y, z);
      if (voxelMap.has(k)) return null;

      const mesh = new THREE.Mesh(boxGeo, mat);
      mesh.position.set(Math.floor(x) + 0.5, Math.floor(y) + 0.5, Math.floor(z) + 0.5);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      scene.add(mesh);

      mesh.userData = {
        gridX: Math.floor(x),
        gridY: Math.floor(y),
        gridZ: Math.floor(z),
        isIndestructible: isIndestructible
      };
      voxelMap.set(k, mesh);
      return mesh;
    }

    function removeBlock(x, y, z) {
      const k = getKey(x, y, z);
      const mesh = voxelMap.get(k);
      if (mesh && !mesh.userData.isIndestructible) {
        scene.remove(mesh);
        voxelMap.delete(k);
        return true;
      }
      return false;
    }

    function generateTree(tx, ty, tz) {
      for (let y = 0; y < 3; y++) {
        addBlock(tx, ty + y, tz, blockMaterials[3]);
      }
      for (let ox = -1; ox <= 1; ox++) {
        for (let oz = -1; oz <= 1; oz++) {
          for (let oy = 2; oy <= 3; oy++) {
            if (ox === 0 && oz === 0 && oy === 2) continue;
            addBlock(tx + ox, ty + oy, tz + oz, blockMaterials[4]);
          }
        }
      }
    }

    function buildLevel(lvlIdx) {
      // Clear previous world
      voxelMap.forEach(mesh => scene.remove(mesh));
      voxelMap.clear();
      quizPillars.forEach(p => scene.remove(p));
      quizPillars = [];
      if (portalMesh) {
        scene.remove(portalMesh);
        portalMesh = null;
      }

      const lvl = LEVELS[lvlIdx];
      solvedCountInLevel = 0;

      scene.background = new THREE.Color(lvl.skyColor);
      scene.fog = new THREE.Fog(lvl.fogColor, 12, 42);

      // Floor plane
      const floorMat = lvl.groundType === "grass" ? grassMatArray : new THREE.MeshLambertMaterial({ map: textures.sand });
      for (let x = -13; x <= 13; x++) {
        for (let z = -13; z <= 13; z++) {
          addBlock(x, 0, z, floorMat);
          addBlock(x, -1, z, blockMaterials[1]);
        }
      }

      // World Boundary Stones
      for (let b = -13; b <= 13; b++) {
        addBlock(b, 1, -13, blockMaterials[2], true);
        addBlock(b, 1, 13, blockMaterials[2], true);
        addBlock(-13, 1, b, blockMaterials[2], true);
        addBlock(13, 1, b, blockMaterials[2], true);
      }

      // Trees
      generateTree(-6, 1, -3);
      generateTree(7, 1, -6);
      generateTree(-7, 1, 7);
      generateTree(6, 1, 5);

      // Spawn Chinese Hanzi Pedestals
      lvl.quizzes.forEach(q => {
        const [qx, qy, qz] = q.pos;
        addBlock(qx, qy, qz, blockMaterials[2], true);

        const pillarTex = makeHanziPillarTexture(q.char, false);
        const pillarMat = new THREE.MeshLambertMaterial({ map: pillarTex });
        const pMesh = new THREE.Mesh(boxGeo, pillarMat);
        pMesh.position.set(qx + 0.5, qy + 1.5, qz + 0.5);
        pMesh.castShadow = true;
        scene.add(pMesh);

        pMesh.userData = {
          isQuiz: true,
          quizData: q,
          solved: false,
          char: q.char
        };
        quizPillars.push(pMesh);
      });

      // Portal Gate Frame
      const portalZ = -11;
      for (let y = 1; y <= 4; y++) {
        addBlock(-2, y, portalZ, blockMaterials[2], true);
        addBlock(2, y, portalZ, blockMaterials[2], true);
      }
      for (let x = -2; x <= 2; x++) {
        addBlock(x, 4, portalZ, blockMaterials[2], true);
      }

      // Portal Energy Field
      const portalGeo = new THREE.PlaneGeometry(3, 3);
      const portalMat = new THREE.MeshBasicMaterial({
        map: textures.portal,
        transparent: true,
        opacity: 0.15,
        side: THREE.DoubleSide
      });
      portalMesh = new THREE.Mesh(portalGeo, portalMat);
      portalMesh.position.set(0, 2.5, portalZ + 0.5);
      scene.add(portalMesh);

      // Reset Player
      player.pos.set(0, 2.0, 5);
      player.vel.set(0, 0, 0);

      updateHUD();
    }

    function updateHUD() {
      const lvl = LEVELS[currentLevelIndex];
      document.getElementById('level-title').innerText = `${lvl.title} (${currentLevelIndex + 1}/${LEVELS.length})`;
      document.getElementById('quest-desc').innerText = lvl.desc;
      document.getElementById('quest-progress').innerText = `已激活石碑: ${solvedCountInLevel} / ${lvl.quizzes.length}`;
    }

    // =========================================================================
    // 6. PLAYER CONTROLS, PHYSICS & VOXEL INTERACTION
    // =========================================================================
    const player = {
      pos: new THREE.Vector3(0, 2.0, 5),
      vel: new THREE.Vector3(0, 0, 0),
      yaw: 0,
      pitch: 0,
      onGround: false,
      selectedSlot: 1
    };

    const keys = { KeyW: false, KeyS: false, KeyA: false, KeyD: false, Space: false };

    window.addEventListener('keydown', (e) => {
      if (keys.hasOwnProperty(e.code)) keys[e.code] = true;
      if (e.code === 'Digit1') selectSlot(1);
      if (e.code === 'Digit2') selectSlot(2);
      if (e.code === 'Digit3') selectSlot(3);
      if (e.code === 'Digit4') selectSlot(4);
    });

    window.addEventListener('keyup', (e) => {
      if (keys.hasOwnProperty(e.code)) keys[e.code] = false;
    });

    function selectSlot(num) {
      player.selectedSlot = num;
      document.querySelectorAll('.hotbar-slot').forEach(el => {
        el.classList.toggle('active', parseInt(el.dataset.slot) === num);
      });
    }

    // Hotbar click support
    document.querySelectorAll('.hotbar-slot').forEach(el => {
      el.addEventListener('click', () => {
        selectSlot(parseInt(el.dataset.slot));
      });
    });

    // Pointer Lock & Pause Management
    const startScreen = document.getElementById('start-screen');
    const playBtn = document.getElementById('play-btn');

    playBtn.addEventListener('click', () => {
      AudioEngine.init();
      document.body.requestPointerLock();
    });

    document.addEventListener('pointerlockchange', () => {
      if (document.pointerLockElement === document.body) {
        startScreen.style.display = 'none';
      } else {
        if (!inQuiz) startScreen.style.display = 'flex';
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (document.pointerLockElement !== document.body || inQuiz) return;
      const sens = 0.0022;
      player.yaw -= e.movementX * sens;
      player.pitch -= e.movementY * sens;
      player.pitch = Math.max(-Math.PI / 2.15, Math.min(Math.PI / 2.15, player.pitch));
    });

    // Mouse Clicks: Mine (Left) / Place (Right) / Trigger Quiz
    const raycaster = new THREE.Raycaster();
    const screenCenter = new THREE.Vector2(0, 0);

    window.addEventListener('mousedown', (e) => {
      if (document.pointerLockElement !== document.body || inQuiz) return;

      raycaster.setFromCamera(screenCenter, camera);

      // Check quiz pillars first
      const quizHits = raycaster.intersectObjects(quizPillars);
      if (quizHits.length > 0 && quizHits[0].distance < 4.8) {
        const p = quizHits[0].object;
        if (!p.userData.solved) {
          openQuiz(p);
          return;
        }
      }

      // Check standard voxel blocks
      const targetMeshes = Array.from(voxelMap.values());
      const hits = raycaster.intersectObjects(targetMeshes);
      if (hits.length === 0 || hits[0].distance > 5.2) return;

      const hit = hits[0];

      if (e.button === 0) {
        // Left-click: Mine Block
        const target = hit.object;
        if (removeBlock(target.userData.gridX, target.userData.gridY, target.userData.gridZ)) {
          AudioEngine.mine();
        }
      } else if (e.button === 2) {
        // Right-click: Place Block
        const placePoint = hit.point.clone().add(hit.face.normal.clone().multiplyScalar(0.5));
        const gx = Math.floor(placePoint.x);
        const gy = Math.floor(placePoint.y);
        const gz = Math.floor(placePoint.z);

        // Prevent placing block directly inside player body
        const px = Math.floor(player.pos.x);
        const pz = Math.floor(player.pos.z);
        const py = Math.floor(player.pos.y);
        if (gx === px && gz === pz && (gy === py || gy === py - 1)) {
          return;
        }

        if (addBlock(gx, gy, gz, blockMaterials[player.selectedSlot])) {
          AudioEngine.place();
        }
      }
    });

    window.addEventListener('contextmenu', e => e.preventDefault());

    // Simple Voxel Collision Box
    function checkCollision(pos) {
      const radius = 0.3;
      const height = 1.6;

      const minX = Math.floor(pos.x - radius);
      const maxX = Math.floor(pos.x + radius);
      const minY = Math.floor(pos.y - height);
      const maxY = Math.floor(pos.y);
      const minZ = Math.floor(pos.z - radius);
      const maxZ = Math.floor(pos.z + radius);

      for (let x = minX; x <= maxX; x++) {
        for (let y = minY; y <= maxY; y++) {
          for (let z = minZ; z <= maxZ; z++) {
            if (voxelMap.has(getKey(x, y, z))) {
              return true;
            }
          }
        }
      }
      return false;
    }

    function updatePhysics(delta) {
      const speed = 6.2;
      const gravity = 22.0;

      // Jump & Gravity
      if (!player.onGround) {
        player.vel.y -= gravity * delta;
      }
      if (keys.Space && player.onGround) {
        player.vel.y = 7.6;
        player.onGround = false;
        AudioEngine.jump();
      }

      // Horizontal Direction
      const move = new THREE.Vector3();
      if (keys.KeyW) move.z -= 1;
      if (keys.KeyS) move.z += 1;
      if (keys.KeyA) move.x -= 1;
      if (keys.KeyD) move.x += 1;
      move.normalize();

      const forward = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.yaw);
      const right = new THREE.Vector3(1, 0, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.yaw);
      const hVel = new THREE.Vector3()
        .addScaledVector(forward, -move.z * speed)
        .addScaledVector(right, move.x * speed);

      // Move X
      const testX = player.pos.clone();
      testX.x += hVel.x * delta;
      if (!checkCollision(testX)) {
        player.pos.x = testX.x;
      }

      // Move Z
      const testZ = player.pos.clone();
      testZ.z += hVel.z * delta;
      if (!checkCollision(testZ)) {
        player.pos.z = testZ.z;
      }

      // Move Y
      const testY = player.pos.clone();
      testY.y += player.vel.y * delta;
      if (checkCollision(testY)) {
        if (player.vel.y < 0) {
          player.onGround = true;
        }
        player.vel.y = 0;
      } else {
        player.pos.y = testY.y;
        player.onGround = false;
      }

      // Void rescue
      if (player.pos.y < -4) {
        player.pos.set(0, 3, 5);
        player.vel.set(0, 0, 0);
      }
    }

    // =========================================================================
    // 7. QUIZ LOGIC & PROGRESSION
    // =========================================================================
    const quizModal = document.getElementById('quiz-modal');
    const quizCharBadge = document.getElementById('quiz-char-badge');
    const quizTitle = document.getElementById('quiz-title');
    const quizPrompt = document.getElementById('quiz-prompt');
    const quizOptions = document.getElementById('quiz-options');
    const pinyinHint = document.getElementById('pinyin-hint');

    function openQuiz(pillarMesh) {
      inQuiz = true;
      document.exitPointerLock();

      const q = pillarMesh.userData.quizData;
      quizCharBadge.innerText = q.char;
      quizTitle.innerText = `华文石碑试炼`;
      quizPrompt.innerHTML = q.prompt;
      pinyinHint.innerText = `读音与结构：${q.pinyin}`;
      quizOptions.innerHTML = '';

      q.options.forEach((optText, index) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-option-btn';
        btn.innerText = optText;
        btn.onclick = () => {
          if (index === q.correct) {
            AudioEngine.correct();
            alert("回答正确！华文之力汇入了石碑。");
            pillarMesh.userData.solved = true;
            pillarMesh.material = new THREE.MeshLambertMaterial({
              map: makeHanziPillarTexture(q.char, true)
            });
            solvedCountInLevel++;
            updateHUD();
            closeQuiz();
            checkLevelClear();
          } else {
            AudioEngine.wrong();
            alert(`回答不正确哦！\n提示：${q.hint}`);
          }
        };
        quizOptions.appendChild(btn);
      });

      quizModal.style.display = 'block';
    }

    function closeQuiz() {
      quizModal.style.display = 'none';
      inQuiz = false;
      document.body.requestPointerLock();
    }

    function checkLevelClear() {
      const lvl = LEVELS[currentLevelIndex];
      if (solvedCountInLevel >= lvl.quizzes.length) {
        portalMesh.material.opacity = 0.85;
        AudioEngine.portal();
        setTimeout(() => {
          alert("✨ 本关石碑试炼已全部解开！传送门已开启，穿过前方的紫晶门即可通关！");
        }, 300);
      }
    }

    function checkPortalTrigger() {
      if (solvedCountInLevel >= LEVELS[currentLevelIndex].quizzes.length) {
        // Portal Gate zone (z = -10.5, x = [-1.5, 1.5])
        if (Math.abs(player.pos.z - (-10.5)) < 1.0 && Math.abs(player.pos.x) < 1.6) {
          if (currentLevelIndex < LEVELS.length - 1) {
            currentLevelIndex++;
            alert(`恭喜通关！即将载入：${LEVELS[currentLevelIndex].title}`);
            buildLevel(currentLevelIndex);
          } else {
            alert("🎉 太棒了！你已顺利完成全部四年级普通华文试炼，成为了语林方块大师！");
            currentLevelIndex = 0;
            buildLevel(currentLevelIndex);
          }
        }
      }
    }

    // =========================================================================
    // 8. ANIMATION ENGINE LOOP
    // =========================================================================
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const delta = Math.min(clock.getDelta(), 0.1);

      if (document.pointerLockElement === document.body && !inQuiz) {
        updatePhysics(delta);
        checkPortalTrigger();
      }

      // Rotate unsolved pillar cubes
      quizPillars.forEach(p => {
        if (!p.userData.solved) {
          p.rotation.y += delta * 0.95;
        }
      });

      // Update camera
      const euler = new THREE.Euler(0, 0, 0, 'YXZ');
      euler.x = player.pitch;
      euler.y = player.yaw;
      camera.quaternion.setFromEuler(euler);
      camera.position.set(player.pos.x, player.pos.y + 0.1, player.pos.z);

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // Start on Level 1
    buildLevel(0);
    animate();
  </script>
</body>
